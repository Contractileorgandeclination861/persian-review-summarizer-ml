# نمونه‌ی تنظیمات — به «.env» کپی کن:  cp .env.example .env

# روش خلاصه‌سازی:
#   extractive  → یادگیری ماشین (TextRank)، سریع، بدون دانلود مدل
#   abstractive → یادگیری عمیق (mT5)، خلاصه‌ی روان‌تر، نیاز به دانلود مدل بار اول
METHOD=extractive

# --- موتور استخراجی ---
SUMMARY_SENTENCES=3

# --- موتور تولیدی (mT5) ---
HF_MODEL_NAME=csebuetnlp/mT5_multilingual_XLSum
DEVICE=cpu
MAX_INPUT_LENGTH=1024
MAX_OUTPUT_LENGTH=90
MIN_OUTPUT_LENGTH=15
NUM_BEAMS=4

# اگر در ایران هستی و دانلود مدل از HuggingFace کند/مسدود است، از آینه استفاده کن:
# HF_ENDPOINT=https://hf-mirror.com

# --- عمومی ---
MAX_REVIEWS=500
